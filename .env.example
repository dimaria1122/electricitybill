AUTH_MODE=login

# Manual token mode. Used when AUTH_MODE=manual.
SYNJONES_AUTH=bearer paste_token_here

# Automatic login mode. Used when AUTH_MODE=login.
LOGIN_USERNAME=your_student_id
LOGIN_PASSWORD=your_password
# Optional. Defaults to web when omitted or empty.
LOGIN_DEVICE_TOKEN=web

ROOM=your_authorized_room_id
FEEITEM_ID=261
QUERY_INTERVAL_MINUTES=30
DATABASE_PATH=electricity.db
